      }
    },
    "登録すると、いま書いた内容がこの場所に置かれます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign up and what you just wrote will be placed right here on the map."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録すると、いま書いた内容がこの場所に置かれます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После регистрации написанное появится прямо здесь, на карте."
          }
        }
      }
    },
    "登録すると、いま書いた返信がそのまま送信されます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign up and your reply will be sent exactly as written."
          }
        },
        "ja": {
          "stringUnit": {
