  "strings": {
    "YouTubeで開く": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in YouTube"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTubeで開く"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть в YouTube"
          }
        }
      }
    },
    "あと少しで書き込めます": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're almost there"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと少しで書き込めます"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почти готово"
          }
        }
      }
    },
    "いいえ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いいえ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет"
          }
        }
      }
    },
    "いまはゲストとして閲覧中です。登録すると、地図に書き込めるようになります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're browsing as a guest. Sign up to start writing on the map."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまはゲストとして閲覧中です。登録すると、地図に書き込めるようになります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы смотрите как гость. Зарегистрируйтесь, чтобы писать на карте."
          }
        }
      }
    },
    "ここ、すごい人": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's packed here"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここ、すごい人"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь очень много людей"
          }
        }
      }
    },
